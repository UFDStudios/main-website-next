generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id               String         @id @default(cuid())
  title            String
  shortDescription String
  longDescription  String
  mainImage        String
  youtubeUrl       String?
  googlePlayLink   String?
  appStoreLink     String?
  enableVideo      Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  genres ProjectGenre[]
  media  Media[]
}

model Genre {
  id   String @id @default(cuid())
  name String @unique

  projects ProjectGenre[]
}

model ProjectGenre {
  projectId String
  genreId   String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  genre   Genre   @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([projectId, genreId])
  @@index([genreId])
}

enum MediaKind {
  IMAGE
  VIDEO
}

model Media {
  id        String    @id @default(cuid())
  projectId String
  url       String
  kind      MediaKind @default(IMAGE)
  sortOrder Int       @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

/// Admin login — add rows via Prisma Studio or SQL (username + password).
model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

